# Configurações do Painel Megasena
# Renomeie este arquivo para .env e preencha com seus dados

# O ID do Cliente OAuth do Google gerado no Google Cloud Console
# Para localhost, certifique-se de adicionar "http://localhost:3000" nas origens JavaScript autorizadas.
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com

# Uma chave secreta qualquer para criptografar os tokens JWT do painel
JWT_SECRET=chave_secreta_para_desenvolvimento_local
